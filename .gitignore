# 依赖文件 (绝对不能传)
node_modules/

# Mac系统自动生成的垃圾文件
.DS_Store

# VitePress 编译生成的临时文件和最终网页
.vitepress/dist
.vitepress/cache
.vitepress/.temp
*.timestamp-*.mjs

# 音频清单为构建时自动扫描生成
public/audio-manifest.json

# 碎碎念全文 JSON 为构建时自动预渲染生成
public/murmurs/

# 环境变量
.env

# 本地 AI 工具记忆目录
.workbuddy/
.creative-design/
# Obsidian workspace state (layout, changes frequently)
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Obsidian community plugin binaries (keep repo clean, reinstall via community market on new devices)
.obsidian/plugins/

# Obsidian theme files (keep repo clean, reinstall via theme market)
.obsidian/themes/
